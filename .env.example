ENVIRONMENT=local
# Example local-only password. Change it before sharing the machine with other users.
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://govintel:change-me-local-only@127.0.0.1:54329/govintel
REDIS_URL=redis://127.0.0.1:63790/0
CAMPAIGN_ID=local
CLAUDE_COMMAND=claude
CLAUDE_TIMEOUT_SECONDS=240
WORKER_POLL_SECONDS=5
JOB_MAX_ATTEMPTS=3
BROWSER_TIMEOUT_MS=20000
BROWSER_MAX_CHARS=10000
# Public-site page budget: 1-5; default 3, keep low on small-RAM machines.
BROWSER_MAX_PAGES=3
GOVINTEL_DATA_DIR=./data

# Public USAspending.gov award-history enrichment (no API key required).
USASPENDING_ENABLED=true
USASPENDING_MAX_AWARDS=5
# Maximum CSV data rows accepted by one enqueue command.
CSV_MAX_ROWS=1000
